public int canCompleteCircuit(int[] petrol, int[] cost) {

    int totalPetrol = 0;
    int currTank = 0;
    int start = 0;

    for (int i = 0; i < petrol.length; i++) {

        int diff = petrol[i] - cost[i];

        totalPetrol += diff;
        currTank += diff;

        if (currTank < 0) {
            start = i + 1;
            currTank = 0;
        }
    }

    return totalPetrol >= 0 ? start : -1;
}							  



