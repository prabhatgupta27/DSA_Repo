 import java.util.*;

public class Solution {
    public static int findShortestCycle(int numNodes, List<List<Integer>> edges) {
        // Step 1: Build the Adjacency List for the Directed Graph
        List<List<Integer>> graph = new ArrayList<>();
        for (int i = 0; i < numNodes; i++) {
            graph.add(new ArrayList<>());
        }
        for (List<Integer> edge : edges) {
            int u = edge.get(0);
            int v = edge.get(1);
            graph.get(u).add(v); // Directed Edge: u -> v
        }

        int shortestCycle = Integer.MAX_VALUE;

        // Step 2: Run BFS from every single node to evaluate its shortest cycle
        for (int i = 0; i < numNodes; i++) {
            int currentCycleLength = locateShortestCycleFromSource(i, numNodes, graph);
            shortestCycle = Math.min(shortestCycle, currentCycleLength);
            
            // Optimization: A cycle cannot be smaller than length 2 in a directed graph (u -> v -> u)
            if (shortestCycle == 2) {
                return 2; 
            }
        }

        return (shortestCycle == Integer.MAX_VALUE) ? -1 : shortestCycle;
    }

    private static int locateShortestCycleFromSource(int source, int numNodes, List<List<Integer>> graph) {
        int[] dist = new int[numNodes];
        Arrays.fill(dist, Integer.MAX_VALUE);
        
        Queue<Integer> queue = new LinkedList<>();
        
        dist[source] = 0;
        queue.add(source);

        while (!queue.isEmpty()) {
            int current = queue.poll();

            for (int neighbor : graph.get(current)) {
                // If we discover a path leading back to the source node, a cycle is completed!
                if (neighbor == source) {
                    return dist[current] + 1;
                }

                // Standard BFS tracking: Visit unvisited nodes
                if (dist[neighbor] == Integer.MAX_VALUE) {
                    dist[neighbor] = dist[current] + 1;
                    queue.add(neighbor);
                }
            }
        }
        
        return Integer.MAX_VALUE;
    }
}



