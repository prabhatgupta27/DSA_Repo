public class ReduceInteger {

    public static int minOperations(int n) {
        int operations = 0;
        
        while (n > 0) {
            // If the current bit is 0, it's free real estate! Just shift right.
            if ((n & 1) == 0) {
                n >>= 1;
            } 
            // If it ends with ...11 in binary, adding 1 clears consecutive bits
            else if ((n & 3) == 3) {
                n += 1;
                operations++;
            } 
            // If it ends with ...01 in binary, subtract the isolated 1
            else {
                n -= 1;
                operations++;
            }
        }
        
        return operations;
    }
}


