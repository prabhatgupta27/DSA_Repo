 import java.util.HashMap;
import java.util.Map;

public class Solution {
    public static int getShortestSubarrayWithKDistinct(int[] nums, int k) {
        if (nums == null || nums.length == 0 || k <= 0) {
            return -1;
        }

        Map<Integer, Integer> counts = new HashMap<>();
        int minLength = Integer.MAX_VALUE;
        int left = 0;

        // Expand the window using the right pointer
        for (int right = 0; right < nums.length; right++) {
            int currentNum = nums[right];
            counts.put(currentNum, counts.getOrDefault(currentNum, 0) + 1);

            // While the window contains exactly k distinct integers, try to optimize
            while (counts.size() == k) {
                // Update the minimum length found so far
                minLength = Math.min(minLength, right - left + 1);

                // Shrink the window from the left
                int leftNum = nums[left];
                counts.put(leftNum, counts.get(leftNum) - 1);
                
                // If the frequency drops to 0, remove it from the map to reduce distinct count
                if (counts.get(leftNum) == 0) {
                    counts.remove(leftNum);
                }
                
                left++;
            }
        }

        return (minLength == Integer.MAX_VALUE) ? -1 : minLength;
    }
}


