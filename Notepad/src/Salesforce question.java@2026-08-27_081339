import java.util.ArrayDeque;
import java.util.Deque;

public class SimpleRateLimiter {

    private static final int LIMIT = 5;
    private static final long WINDOW_SIZE = 1000; // 1 second (1000 ms)

    private final Deque<Long> queue = new ArrayDeque<>();

    public synchronized boolean allowRequest() {
        long now = System.currentTimeMillis();

        // 1. Evict timestamps outside the active rolling window
        while (!queue.isEmpty() && now - queue.peekFirst() >= WINDOW_SIZE) {
            queue.pollFirst();
        }

        // 2. Accept or reject based on the current window count
        if (queue.size() < LIMIT) {
            queue.offerLast(now);
            return true;
        }

        return false;
    }

    public static void main(String[] args) throws InterruptedException {
        SimpleRateLimiter limiter = new SimpleRateLimiter();

        System.out.println("--- Phase 1: Rapid burst of 7 requests (Limit: 5/sec) ---");
        for (int i = 1; i <= 7; i++) {
            boolean allowed = limiter.allowRequest();
            System.out.printf("Request #%d: %s%n", i, allowed ? "ALLOWED" : "BLOCKED (429 Too Many Requests)");
        }

        System.out.println("\n--- Phase 2: Sleeping for 1100 ms (Window Expiration) ---");
        Thread.sleep(1100);

        System.out.println("\n--- Phase 3: New request after window reset ---");
        boolean allowedAfterWait = limiter.allowRequest();
        System.out.printf("Request #8: %s%n", allowedAfterWait ? "ALLOWED" : "BLOCKED");
    }
}

import java.util.Deque;
import java.util.LinkedList;

public class StaticLinkedListRateLimiter {

    private static final int LIMIT = 5;
    private static final long WINDOW_SIZE = 1000; // 1 second (1000 ms)

    // Static queue shared across the entire class
    private static final Deque<Long> queue = new LinkedList<>();

    // Static synchronized locks on StaticLinkedListRateLimiter.class
    public static synchronized boolean allowRequest() {
        long now = System.currentTimeMillis();

        // 1. Evict expired entries from head of linked list
        while (!queue.isEmpty() && now - queue.peekFirst() >= WINDOW_SIZE) {
            queue.pollFirst();
        }

        // 2. Check window capacity
        if (queue.size() < LIMIT) {
            queue.offerLast(now);
            return true;
        }

        return false;
    }

    public static void main(String[] args) throws InterruptedException {
        // Direct calls inside a loop without creating any instance
        for (int i = 1; i <= 7; i++) {
            boolean allowed = allowRequest();
            System.out.printf("Request #%d -> %s%n", i, allowed ? "ALLOWED" : "BLOCKED (429)");
        }

        System.out.println("\nWaiting 1.1s for window to reset...\n");
        Thread.sleep(1100);

        for (int i = 8; i <= 10; i++) {
            boolean allowed = allowRequest();
            System.out.printf("Request #%d -> %s%n", i, allowed ? "ALLOWED" : "BLOCKED (429)");
        }
    }
}


import java.util.Iterator;
import java.util.LinkedHashSet;

public class Main {

    static class LRUCache {

        private final int capacity;
        private final LinkedHashSet<Integer> cache = new LinkedHashSet<>();

        public LRUCache(int capacity) {
            this.capacity = capacity;
        }

        public void add(int value) {

            // If already exists, remove first
            // so it becomes most recently used
            cache.remove(value);

            // If new element and cache is full
            if (cache.size() == capacity) {
                Iterator<Integer> iterator = cache.iterator();

                if (iterator.hasNext()) {
                    iterator.next(); // First = LRU
                    iterator.remove();
                }
            }

            // Add as most recently used
            cache.add(value);
        }

        public int get(int value) {

            if (!cache.contains(value)) {
                return -1;
            }

            // Accessed value becomes most recently used
            cache.remove(value);
            cache.add(value);

            return value;
        }

        public void print() {
            System.out.println(cache);
        }
    }

    public static void main(String[] args) {

        LRUCache cache = new LRUCache(3);

        cache.add(1);
        cache.add(2);
        cache.add(3);

        cache.print(); // [1, 2, 3]

        cache.get(1);

        cache.print(); // [2, 3, 1]

        cache.add(4);

        cache.print(); // [3, 1, 4]
    }
}