 public class Solution {
    public static String compressString(String s) {
        if (s == null || s.isEmpty()) {
            return "";
        }

        StringBuilder compressed = new StringBuilder();
        int i = 0;
        int n = s.length();

        // Loop through the string block by block
        while (i < n) {
            char currentChar = s.charAt(i);
            int j = i;

            // Scan forward as long as the characters match
            while (j < n && s.charAt(j) == currentChar) {
                j++;
            }

            // The number of repetitions is the distance between the pointers
            int count = j - i;

            // Append the character itself
            compressed.append(currentChar);

            // Crucial Catch: Only append the count if it's greater than 1
            if (count > 1) {
                compressed.append(count);
            }

            // Jump the anchor pointer to the start of the next distinct block
            i = j;
        }

        return compressed.toString();
    }
}


