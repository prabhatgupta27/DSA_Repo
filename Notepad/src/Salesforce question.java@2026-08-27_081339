import java.util.HashMap;
import java.util.Map;

public class StableServers {

    public static long countStableSegments(int[] capacity) {
        int n = capacity.length;
        if (n < 3) return 0;

        // Precompute Prefix Sums
        long[] pref = new long[n];
        pref[0] = capacity[0];
        for (int i = 1; i < n; i++) {
            pref[i] = pref[i - 1] + capacity[i];
        }

        // Map key format: "capacityValue_requiredPrefixSum"
        Map<String, Integer> signatureMap = new HashMap<>();
        long stableSegmentsCount = 0;

        // Start from r = 2 because the minimum valid segment length is 3
        for (int r = 2; r < n; r++) {
            // Dynamically add the valid left endpoint (r - 2) to the map
            int l = r - 2;
            String leftSignature = capacity[l] + "_" + (pref[l] + capacity[l]);
            signatureMap.put(leftSignature, signatureMap.getOrDefault(leftSignature, 0) + 1);

            // Look up if a matching target signature exists for the current right endpoint
            String targetSignature = capacity[r] + "_" + pref[r - 1];
            if (signatureMap.containsKey(targetSignature)) {
                stableSegmentsCount += signatureMap.get(targetSignature);
            }
        }

        return stableSegmentsCount;
    }
}


