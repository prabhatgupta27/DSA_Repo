public class MinOperations {

    /**
     * Calculates minimum operations using arithmetic logic.
     * Time Complexity: O(log N)
     * Space Complexity: O(1)
     */
    public int minOperations(int n) {
        int ops = 0;
        
        while (n > 0) {
            // Case 1: Even number, just divide by 2
            if (n % 2 == 0) {
                n /= 2;
            } 
            // Case 2: Ends in ...11, add 1 to trigger carry
            else if (n % 4 == 3) {
                n += 1;
                ops++;
            } 
            // Case 3: Ends in ...01, subtract 1 to clear bit
            else {
                n -= 1;
                ops++;
            }
        }
        return ops;
    }

