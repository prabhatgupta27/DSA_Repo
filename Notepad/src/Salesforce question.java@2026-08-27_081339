import java.util.PriorityQueue;

public class ReorganizeStringSolution {

    public static String reorganizeString(String s) {
        int n = s.length();
        int[] frequencyMap = new int[26];
        
        // Step 1: Count character frequencies
        for (int i = 0; i < n; i++) {
            frequencyMap[s.charAt(i) - 'a']++;
        }
        
        // Step 2: Initialize Max-Heap based on frequency counts
        PriorityQueue<char[]> maxHeap = new PriorityQueue<>((a, b) -> b[1] - a[1]);
        
        for (int i = 0; i < 26; i++) {
            if (frequencyMap[i] > 0) {
                // If any single character exceeds the mathematical limit, it's impossible
                if (frequencyMap[i] > (n + 1) / 2) {
                    return "";
                }
                maxHeap.offer(new char[]{(char) (i + 'a'), (char) frequencyMap[i]});
            }
        }
        
        StringBuilder result = new StringBuilder();
        
        // Step 3: Process the top 2 elements greedily
        while (maxHeap.size() >= 2) {
            char[] first = maxHeap.poll();
            char[] second = maxHeap.poll();
            
            result.append(first[0]);
            result.append(second[0]);
            
            // If frequencies remain, update and re-insert into the heap
            if (--first[1] > 0) maxHeap.offer(first);
            if (--second[1] > 0) maxHeap.offer(second);
        }
        
        // Step 4: Handle the final remaining single character (if any)
        if (!maxHeap.isEmpty()) {
            char[] last = maxHeap.poll();
            result.append(last[0]);
        }
        
        return result.toString();
    }
}


