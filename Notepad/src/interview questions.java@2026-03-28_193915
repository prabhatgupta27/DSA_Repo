
public class Singleton {
    private static volatile Singleton instance; // volatile => it will create in main memory instead of cache

    private Singleton() {}

    public static Singleton getInstance() {
        if (instance == null) {
            synchronized (Singleton.class) {
                if (instance == null) {
                    instance = new Singleton();
                }
            }
        }
        return instance;
    }
}


