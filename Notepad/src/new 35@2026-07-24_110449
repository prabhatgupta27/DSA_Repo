import java.util.HashMap;
import java.util.Map;

class Solution {
    public int subarraySum(int[] nums, int k) {
        Map<Integer, Integer> prefixSumFreq = new HashMap<>();
        
        // Base case: A prefix sum of 0 has occurred once before starting iteration
        prefixSumFreq.put(0, 1);

        int currentPrefixSum = 0;
        int count = 0;

        for (int num : nums) {
            currentPrefixSum += num;
            int targetPrefixSum = currentPrefixSum - k;

            // If (currentPrefixSum - k) exists in map, add its frequency to total count
            if (prefixSumFreq.containsKey(targetPrefixSum)) {
                count += prefixSumFreq.get(targetPrefixSum);
            }

            // Store/update frequency of current prefix sum
            prefixSumFreq.put(currentPrefixSum, prefixSumFreq.getOrDefault(currentPrefixSum, 0) + 1);
        }

        return count;
    }
}


