You have an array intervals[i] = {start, end}
Merge all overlapping intervals, and return an array of the non-overlapping intervals.
 
Example:
Input: intervals = {{1,3},{2,6},{8,10},{15,18}}
Output: {{1,6},{8,10},{15,18}}


 publi static List<List<Integer>> mergeInterval(List<List<Integer>> input) {

        List<List<Integer>> result = new ArrayList<>();


        input.sort((a, b) -> a.get(0) - b.get(0));

        int start = input.get(0).get(0);
        int end = input.get(0).get(1);

        for (int i = 1; i < input.size(); i++) {

            List<Integer> arr = input.get(i);

            int nextStart = arr.get(0);
            int nextEnd = arr.get(1);

            if (nextStart <= end) {

                end = Math.max(end, nextEnd);

            } else {

                result.add(Arrays.asList(start, end));

                start = nextStart;
                end = nextEnd;
            }
        }

        result.add(Arrays.asList(start, end));

        return result;
    }
