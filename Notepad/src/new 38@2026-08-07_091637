public class OddEven<T> implements Iterator<T>{
	
	private final Iterator<T> iterator;
	private final boolean even;
	private int index = 0;
	private T nextElement;
	
	public OddEven(Iterator<T> iterator, boolean even){
		this.iterator = iterator;
		this.even = even;
		process();
		
	}
	
	private void process(){
		
		nextElement = null;
		
		while(iterator.hasNext()){
			T curr = iterator.next();
			
			if((index % 2 == 0) && even){
				nextElement = curr;
				index++;
				return;
			}
			index++;
		}
	}
	
}

